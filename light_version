import tkinter as tk
from datetime import datetime, date
import os

# Faili nimi kuhu kõike salvestatakse ja mida kuvatakse programmi käivitamisel
DATA_FILE = "events.txt"

# Peamine list, kuhu salvestatakse kõik sündmuste andmed sõnastikena
all_events = []

def load_events():  
    """Loads events from a plain text file on startup."""
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                
                # Split the line by '|' to get name and date string back
                parts = line.split("|")
                if len(parts) == 2:
                    name = parts[0]
                    date_str = parts[1]
                    
                    try:
                        event_date = datetime.strptime(date_str, "%d.%m.%Y").date()
                        today = date.today()
                        delta = event_date - today
                        
                        event_record = {
                            "name": name,
                            "date_str": date_str,
                            "date_obj": event_date,
                            "days_left": delta.days
                        }
                        all_events.append(event_record)
                    except ValueError:
                        pass # Ignore corrupted lines
            
            # Sort chronologically after loading
            all_events.sort(key=lambda x: x['date_obj'])

def save_events():  # sündmuste failisse sissekirjutamiseks, salvestab puhtalt tekstina mida hiljem load_events ümbertöötleb andmeks
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        for event in all_events:
            # Write each event as: Name|DD.MM.YYYY
            f.write(f"{event['name']}|{event['date_str']}\n")

def add_event():
    name = name_entry.get().strip() # nimeks saab aknast name_entry stringina tänau .get()
    date_text = date_entry.get().strip() #saab kuupäeva aknast date_entry stringina
    
    # 1. Kontroll kas aknas on sisestatud sündmuse nimi
    if not name:
        status_label.config(text="Please enter an event name.", fg="red")
        return

    parts = date_text.split(".") #Kuupäeva sisestus jagatakse punktide järgi osadeks Päev.Kuu.Aasta -> ['Päev', 'Kuu', 'Aasta']
    if len(parts) == 3 and all(p.isdigit() for p in parts): #kui osade arv on 3 ja kõik osad on numbrid, siis jätkatakse
        try:
            # Kasutades datetime konverteerib stringi kuupäevaks
            event_date = datetime.strptime(date_text, "%d.%m.%Y").date()

            #peamine datetime rakends: leida mis kuupäev on täna ja arvutada kui palju päevi on sündmuseni jäänud
            today = date.today()
            delta = event_date - today
            days_remaining = delta.days

            # Loob sõnastiku?
            event_record = {
                "name": name,
                "date_str": date_text,
                "date_obj": event_date,
                "days_left": days_remaining
            }
            
            all_events.append(event_record) #lisab sõnastiku listi all_events

            # 2. Sort the list chronologically by date objects
            all_events.sort(key=lambda x: x['date_obj'])
            
            # Save to text file immediately after adding
            save_events()
 
            # Clear entry boxes for the next input
            name_entry.delete(0, tk.END)
            date_entry.delete(0, tk.END)

            # Refresh the visual display list
            update_display()
            status_label.config(text="Event added successfully!", fg="green")
            return

        except ValueError:
            status_label.config(text="Invalid date! (Check for impossible days like Feb 31)", fg="red")
            return

    status_label.config(text="Invalid format. Please use DD.MM.YYYY", fg="red")

def update_display():
    # Enable the text widget temporarily to insert text
    display_box.config(state=tk.NORMAL)
    display_box.delete("1.0", tk.END)
    
    for event in all_events:
        days = event['days_left']
        if days > 0:
            time_text = f"{days} on jäänud"
        elif days == 0:
            time_text = "Täna"
        else:
            time_text = f"{-(days)} päevi tagasi"
            
        line = f"• {event['name']} ({event['date_str']}) — {time_text}\n"
        display_box.insert(tk.END, line)
        
    # Make it read-only again so users can't manually type inside it
    display_box.config(state=tk.DISABLED)

#GUI Window Setup
root = tk.Tk()
root.title("Event Countdown Tracker")
root.geometry("400x450")

# Event Name Field
tk.Label(root, text="Event Name:", font=("Arial", 10, "bold")).pack(pady=(15, 0))
name_entry = tk.Entry(root, width=30, font=("Arial", 11))
name_entry.pack(pady=5)

# Date Field
tk.Label(root, text="Date (DD.MM.YYYY):", font=("Arial", 10, "bold")).pack(pady=(5, 0))
date_entry = tk.Entry(root, width=30, font=("Arial", 11))
date_entry.pack(pady=5)

# Submit Button
submit_btn = tk.Button(root, text="Add Event", command=add_event, bg="#4CAF50", fg="white", font=("Arial", 10, "bold"))
submit_btn.pack(pady=10)

# Status Feedback Label
status_label = tk.Label(root, text="", font=("Arial", 9))
status_label.pack(pady=2)

# Display Area Header
tk.Label(root, text="Saved Events (Closest to Furthest):", font=("Arial", 10, "bold")).pack(pady=(15, 0))

# Text Box to show stored events
display_box = tk.Text(root, height=10, width=45, state=tk.DISABLED, font=("Arial", 10))
display_box.pack(pady=5)

#Load previous data and refresh display on startup
load_events()
update_display()

# start the application loop
root.mainloop()
